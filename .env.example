# Harvest (required)
HARVEST_ACCESS_TOKEN=
HARVEST_ACCOUNT_ID=
HARVEST_PROJECT_ID=44434590      # Gradient Routing (client: AI Alignment Foundation)
HARVEST_TASK_ID=6225477          # Data Science
HARVEST_HOURS=8.0
HARVEST_TIMEZONE=America/Los_Angeles

# Notes sources (each optional)
GOOGLE_CALENDAR_ICS_URL=         # Google Calendar > Settings > your calendar > Integrate calendar > "Secret address in iCal format"
CALENDAR_OWNER_EMAIL=            # so declined invites are skipped
CALENDAR_EXCLUDE_REGEX=          # default drops focus/lunch/OOO/hold/etc.
ANTHROPIC_API_KEY=               # summariser; without it the logged-in `claude` CLI is used
ANTHROPIC_MODEL=claude-opus-5
SLURM_SSH_HOST=aes-cluster       # blank to disable cluster job lookup
SLURM_TZ=UTC
LOCAL_REPO_GLOBS=/Users/erick/projects/*   # colon-separated globs
GITHUB_TOKEN=                    # optional extra source (events feed)
GITHUB_LOGIN=erickfm

# Behaviour / wording
NOTES_TODAY_AFTER_HOUR=20        # --notes-only skips today before this hour
HARVEST_DEFAULT_NOTE=Gradient routing / GRAM research: experiment monitoring, analysis and code work.
HARVEST_PROJECT_CONTEXT=Gradient routing / GRAM research at AE Studio (AIAF-funded): training-run babysitting, data filtering and classification, evaluation, paper writing.
